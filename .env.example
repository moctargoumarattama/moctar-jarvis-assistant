# Liste explicite : numeros internationaux separes par des virgules.
# Exemple de format : +212600000001,+22790000000
# Vide = commandes WhatsApp desactivees, meme si ADMIN_PHONE_NUMBER est renseigne.
WHATSAPP_ADMIN_NUMBERS=
NOC_WHATSAPP_WEBHOOK_TOKEN=
NOC_GATEWAY_SECRET=
NOC_WHATSAPP_SESSION_ID=1
NOC_WHATSAPP_SEND_URL=http://127.0.0.1:3001/message/send

# Le modele doit etre installe dans le serveur Ollama utilise.
OLLAMA_BASE_URL=http://localhost:11434
# Developpement Windows vers le Dell : OLLAMA_BASE_URL=http://192.168.11.103:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=120
