# Portabilite Hybride & Mode Headless Auto-Adaptatif
# Laisser vide pour resoudre automatiquement vers le dossier du depot (/opt/jarvis, /app, C:\Users\hp\Jarvis)
# JARVIS_APP_ROOT=/opt/jarvis
# Mode audio/affichage : auto (detecte carte son + X11/Wayland), true (force headless VPS/Docker), false (force materiel local)
JARVIS_HEADLESS=auto

# Liste explicite : numeros internationaux separes par des virgules.
# Exemple de format : +212600000001,+22790000000
# Vide = commandes WhatsApp desactivees, meme si ADMIN_PHONE_NUMBER est renseigne.
WHATSAPP_ADMIN_NUMBERS=
NOC_WHATSAPP_WEBHOOK_TOKEN=
NOC_GATEWAY_SECRET=
NOC_VPS_TOKEN=vps-secret-token-precision
NOC_WHATSAPP_SESSION_ID=1
NOC_WHATSAPP_SEND_URL=http://127.0.0.1:3001/message/send

# Supervision & Watchdog de la passerelle WhatsApp Baileys (port 3001)
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
# Commande locale optionnelle de relance automatique (backoff exponentiel, max 3 essais / 10 min)
WHATSAPP_BRIDGE_RESTART_CMD=

# HTTPS natif : active seulement si les deux fichiers existent, sinon HTTP.
# Laisser commente pour utiliser automatiquement <JARVIS_APP_ROOT>/certs/server.{key,crt}
# NOC_SSL_KEYFILE=/opt/jarvis/certs/server.key
# NOC_SSL_CERTFILE=/opt/jarvis/certs/server.crt
# Dans l'environnement Baileys, utiliser https lorsque les certificats sont presents.
# Le certificat auto-signe est accepte uniquement pour les destinations locales.
# NOC_API_BASE_URL=https://127.0.0.1:5050

# Moteur IA primaire (Google Gemini Cloud) & Secours rapide (Groq Llama 3.3 70B)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Delai Cloud, minimum Google : 10 secondes.
GEMINI_TIMEOUT_SECONDS=15.0
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MOCTAR_AGENT_MAX_STEPS=5
MOCTAR_AGENT_THINKING=auto

# Localisation par defaut (meteo & recherches locales)
JARVIS_DEFAULT_CITY=Casablanca, Morocco

# Voix neuronale masculine moderne (Edge-TTS : fr-FR-RemyMultilingualNeural, fallback fr-FR-HenriNeural)
JARVIS_TTS_VOICE=fr-FR-RemyMultilingualNeural

# Contrôle Média & Spotify
SPOTIFY_PLAYLIST_URI=
