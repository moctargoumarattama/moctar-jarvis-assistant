# Liste explicite : numeros internationaux separes par des virgules.
# Exemple de format : +212600000001,+22790000000
# Vide = commandes WhatsApp desactivees, meme si ADMIN_PHONE_NUMBER est renseigne.
WHATSAPP_ADMIN_NUMBERS=
NOC_WHATSAPP_WEBHOOK_TOKEN=
NOC_GATEWAY_SECRET=
NOC_VPS_TOKEN=vps-secret-token-precision
NOC_WHATSAPP_SESSION_ID=1
NOC_WHATSAPP_SEND_URL=http://127.0.0.1:3001/message/send

# HTTPS natif : active seulement si les deux fichiers existent, sinon HTTP.
NOC_SSL_KEYFILE=/opt/jarvis/certs/server.key
NOC_SSL_CERTFILE=/opt/jarvis/certs/server.crt
# Dans l'environnement Baileys, utiliser https lorsque les certificats sont presents.
# Le certificat auto-signe est accepte uniquement pour les destinations locales.
# NOC_API_BASE_URL=https://127.0.0.1:5050

# Moteur IA exclusif : Google Gemini Cloud.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Delai Cloud, minimum Google : 10 secondes.
GEMINI_TIMEOUT_SECONDS=15.0
MOCTAR_AGENT_MAX_STEPS=5
MOCTAR_AGENT_THINKING=auto
