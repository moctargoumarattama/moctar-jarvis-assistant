OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
PICOVOICE_ACCESS_KEY=
OPENWEATHER_API_KEY=replace-me
NEWS_API_KEY=replace-me
GOOGLE_MAPS_API_KEY=replace-me
JARVIS_BROWSER=default
JARVIS_BROWSER_DUPLICATE_COOLDOWN=4
JARVIS_WAKE_WORD=jarvis
JARVIS_WAKE_WORD_PATH=
ENABLE_SOFT_WAKE_WORD=true
SOFT_WAKE_LANGUAGE=fr-FR
SOFT_WAKE_TIMEOUT=2
SOFT_WAKE_PHRASE_LIMIT=2
SOFT_WAKE_COOLDOWN_SECONDS=1.5
JARVIS_MIC_INDEX=2
MOCTAR_IOT_BASE_URL=
MOCTAR_IOT_TIMEOUT=3
MOCTAR_IOT_TEMP_THRESHOLD=30
MOCTAR_REQUIRE_CONFIRMATION=true
MOCTAR_ALLOW_SYSTEM_ACTIONS=true
MOCTAR_ALLOW_WEB_ACTIONS=true
MOCTAR_ALLOW_MUSIC_ACTIONS=true
MOCTAR_ALLOW_PROJECT_ACTIONS=true
MOCTAR_ALLOW_PERSONAL_ACTIONS=true
MOCTAR_ALLOW_ENERGY_ACTIONS=true
MOCTAR_ALLOW_IOT_ACTIONS=true
MOCTAR_ALLOW_LOCAL_AI=true

# --------------------------------------------------------------------------- #
#  Scheduler — Publication automatique                                        #
# --------------------------------------------------------------------------- #
# Les publications Facebook et WhatsApp utilisent Playwright (navigateur local).
# Aucune clé API n'est requise.  Installez les navigateurs avec :
#   playwright install chromium
